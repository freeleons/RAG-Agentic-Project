# Copy this file to .env and fill in values. NEVER commit your real .env.

# --- Flask ---
FLASK_ENV=development
SECRET_KEY=change-me-to-a-random-string

# Comma-separated emails that get the admin audit view (see all users' runs)
ADMIN_EMAILS=

# --- Database (Postgres or SQLite) ---
# Postgres (default for dev) — start it with:
#   docker run -d -p 5432:5432 -e POSTGRES_PASSWORD=agent -e POSTGRES_DB=agentdb \
#     -v agentdb_data:/var/lib/postgresql/data --name agentdb postgres:16
# SQLite fallback:  sqlite:///agent.db
DATABASE_URL=postgresql+psycopg2://postgres:agent@localhost:5432/agentdb

# --- Knowledge service: AnythingLLM (Project 1) ---
# Run AnythingLLM (see docs/anythingllm-setup.md), create a workspace, load the
# docs in knowledge_base/, then create a developer API key in its settings.
# STORAGE_DIR is required by the AnythingLLM container (path *inside* the
# container where it persists data) — pass it with: docker run -e STORAGE_DIR ...
# If you are using GitHub Codespaces/GitHub.dev, replace localhost with the
# forwarded public URL for port 3001, e.g.:
#   https://ideal-space-funicular-jjrqwrvv9g5f95r-3001.app.github.dev
STORAGE_DIR=/app/server/storage
ANYTHINGLLM_BASE_URL=http://localhost:3001
ANYTHINGLLM_API_KEY=paste-your-anythingllm-api-key-here
ANYTHINGLLM_WORKSPACE=apprentice-kb

# --- Agent reasoning model (must support function/tool calling) ---
# Default: local + free via Ollama.
OLLAMA_BASE_URL=http://localhost:11434
AGENT_MODEL=llama3.1:8b
# Optional hosted upgrade for more reliable tool calling (Anthropic/OpenAI-compatible
# endpoint, e.g. MiniMax Token Plan). Leave blank to use Ollama above.
# AGENT_API_BASE_URL=
# AGENT_API_KEY=

# --- Agent guardrails ---
MAX_AGENT_STEPS=6
TOOL_TIMEOUT_SECONDS=20
